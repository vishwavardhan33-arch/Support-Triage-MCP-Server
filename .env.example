# --- Local (default) ---
# Uses a locally-running Ollama instance. Install from https://ollama.com,
# then `ollama pull llama3.2` (or llama3.1 / mistral for better quality).
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# --- Hosted (for deployment, e.g. Render/Fly.io) ---
# Groq offers a free API key (console.groq.com) and OpenAI-compatible chat
# completions. Uncomment these three lines and comment out the two above
# to use it instead of local Ollama.
# OLLAMA_URL=https://api.groq.com/openai/v1/chat/completions
# OLLAMA_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=your-groq-api-key-here

# Port the web UI (app.py) listens on. Render/Fly.io set this automatically —
# only needed for local overrides.
# PORT=8000
